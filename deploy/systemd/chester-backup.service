[Unit]
Description=Nightly off-box backup sweep (rclone copy, never sync)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/rclone_sync.sh

# NOT listed as success: 1 (no rclone, no remote, no venv), 2 (the database
# snapshot, its integrity check or its compression failed), 3 (a tree did not
# copy or hit its time cap), 4 (terminated mid-sweep). Every one of those means the
# off-box copy did not happen, and a backup that quietly did not happen is the
# failure this whole unit exists to prevent. Only 0 is success, so
# `systemctl --user list-units --failed` goes red until a sweep completes.

# Sized to the job, and ABOVE the script's own caps. Each tree runs under a
# coreutils `timeout` (db 20m, data 40m, backups 30m, state 10m; the db/ prune
# 5m to list plus 2m a delete), so a stalled tree fails as itself, rc 3, and is
# named in the status line. This ceiling only catches what the caps cannot:
# a hung snapshot or compression. On 29 Sep 2026 a Drive quota stall ran into
# the old 2h ceiling with no per-tree cap, so systemd killed the sweep and no
# status line said which tree had stalled; the script now traps the SIGTERM
# and writes state=killed (rc 4).
TimeoutStartSec=2h30min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
# rclone reads its own config from ~/.config/rclone; the staged snapshot is
# written under the state dir. -%h/state because the box redirects
# CHESTER_STATE_DIR there by drop-in (chester-heartbeat.service declares it the
# same way; the leading - lets the unit start where the directory is absent).
# %h/chester-reports/data because a mode=ro open of the WAL store must be able
# to create chester.db-shm and chester.db-wal beside the file -- they do not
# exist after a clean close -- and a read-only data/ refuses the snapshot. The
# innermost path wins, so the rest of the repo stays read-only below.
ReadWritePaths=%h/logs %h/.chester -%h/state %h/chester-reports/data
ReadOnlyPaths=%h/chester-reports %h/backups %h/.config/rclone
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
