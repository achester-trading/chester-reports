[Unit]
Description=Nightly off-box backup sweep (rclone copy, never sync)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/rclone_sync.sh
# The crypt settings (audit-leftovers-1): CHESTER_RCLONE_BACKUP_REMOTE,
# CHESTER_RCLONE_CRYPT_PASSWORD, CHESTER_RCLONE_CRYPT_SALT and
# CHESTER_RCLONE_INBOX_REMOTE are .env's (scripts/rclone_crypt_env.sh). Optional,
# as for every unit: without them the sweep exits 1, no_crypt, by name.
EnvironmentFile=-%h/chester-reports/.env

# NOT listed as success: 1 (no rclone, no remote, no venv), 2 (the database
# snapshot, its integrity check or its compression failed), 3 (a tree did not
# copy or hit its time cap), 4 (terminated mid-sweep). Every one of those means the
# off-box copy did not happen, and a backup that quietly did not happen is the
# failure this whole unit exists to prevent. Only 0 is success, so
# `systemctl --user list-units --failed` goes red until a sweep completes.

# Sized to the job, and ABOVE the script's own caps. Each tree runs under a
# coreutils `timeout` (db 20m, data 40m, backups 30m, state 10m, chester-data
# 15m; the db/ prune
# 5m to list plus 2m a delete), so a stalled tree fails as itself, rc 3, and is
# named in the status line. This ceiling only catches what the caps cannot:
# a hung snapshot or compression. On 29 Sep 2026 a Drive quota stall ran into
# the old 2h ceiling with no per-tree cap, so systemd killed the sweep and no
# status line said which tree had stalled; the script now traps the SIGTERM
# and writes state=killed (rc 4).
#
# 2h, NOT 2h30min (AUD-2, ruled 14 Oct 2026): 02:30 plus the timer's 5 minutes
# of jitter plus 2h30 could run to 05:05, into the Sunday 05:00 Weekly -- and the
# Weekly does not move, because the Alpha Lab's Sunday loop waits on it. THE
# SWEEP'S OWN BUDGET ENDS IT: scripts/rclone_sync.sh gives the whole sweep 105
# minutes (AUD-1), so it stops itself and names what it skipped before systemd's
# ceiling is reached. 2h is the BACKSTOP, not the plan: if the budget ever fails,
# systemd ends the sweep by 04:35 (state=killed, rc 4), still clear of the Weekly.
TimeoutStartSec=2h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
# rclone reads its own config from ~/.config/rclone; the staged snapshot is
# written under the state dir. -%h/state because the box redirects
# CHESTER_STATE_DIR there by drop-in (chester-heartbeat.service declares it the
# same way; the leading - lets the unit start where the directory is absent).
# %h/chester-reports/data because a mode=ro open of the WAL store must be able
# to create chester.db-shm and chester.db-wal beside the file -- they do not
# exist after a clean close -- and a read-only data/ refuses the snapshot. The
# innermost path wins, so the rest of the repo stays read-only below.
# -%h/chester-data/inbox/aaii (10 Oct 2026): the sweep's one inbound copy, the
# AAII weekly file, lands there; the rest of ~/chester-data stays read-only.
# -%h/chester-data/inbox/etf (12 Oct 2026): the GLD archive's one-time copy
# from Drive chester-vendor-checks/etf/ lands there, the same way.
# The leading - skips each where the directory is absent, so it must exist
# before the sweep starts for the pull to write.
# -%h/chester-data/inbox/spdji (13 Oct 2026): S&P DJI's EPS workbook, the same
# way; mkdir -p it once.
# -%h/chester-data/inbox/x-triage and x-digest (17 Oct 2026): the X pilot's two
# ledgers and daily digests, for the Digital Assets addendum; mkdir -p both once.
# -%h/backups/chains (AUD-1 item 1b): the sweep deletes a local chain zip past
# the newest 14, and only once the remote holds that exact file.
# -%h/chester-data/inbox/lab (X-2.11, 14 Oct 2026): the Alpha Lab's inbox -- the
# sweep lists Drive's lab-inbox into its manifest and copies the batches there.
# The outbox is only READ by the sweep (copied up), so it needs no grant.
ReadWritePaths=%h/logs %h/.chester -%h/state %h/chester-reports/data -%h/chester-data/inbox/aaii -%h/chester-data/inbox/spdji -%h/chester-data/inbox/etf -%h/chester-data/inbox/x-triage -%h/chester-data/inbox/x-digest -%h/backups/chains -%h/chester-data/inbox/lab
ReadOnlyPaths=%h/chester-reports %h/backups %h/.config/rclone -%h/chester-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# MEMORY CAPS (AUD-2 item 3, session-set for the 8 GB box): MemoryHigh throttles and
# reclaims, MemoryMax is the hard ceiling the kernel kills at. README.md section 13.
MemoryHigh=1.2G
MemoryMax=1.5G
# THE OOM ORDER (AUD-2, ruled 14 Oct 2026; README.md section 13). If the caps are
# not enough, the kernel kills the highest score first: a report can be rendered
# again; a day's chains cannot be fetched again; the Gateway needs Ari's supervised
# login. So the reports 500, the EOD capture 300, the Gateway -500. Raising a score
# needs no privilege, so this order holds on a --user unit without root.
OOMScoreAdjust=500
