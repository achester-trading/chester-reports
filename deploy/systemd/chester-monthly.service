[Unit]
Description=Monthly Regime & Allocation (1st at 07:30 ET; six sections, reads the object)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

# AFTER THE MORNING CHAIN, as ordering only. The 06:45 overnight pass refreshes the
# feeds and the 07:00 anchor reads the object; this fires at 07:30 so it sees both.
# Never a requirement: the report reads STORED data and must still run and report
# absences when an upstream pass did not, because a report that stays silent
# because its input failed hides exactly the failure worth knowing about.
After=chester-overnight.service chester-morning-anchor.service

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/run_monthly.sh

# THE SECRETS, THROUGH THE LOADER. altdata.secrets reads this file itself, so the
# narrative's key and FRED's resolve identically for the unit and for a human at a
# prompt -- which is the fix E1 made after os.environ alone reported a key missing
# for every run that was not the timer's. The leading `-` keeps the unit startable
# on a box with no .env: a missing secret costs a feature, not the run.
EnvironmentFile=-%h/chester-reports/.env

# 0 built. 1 is NOT here: the Monthly's failure mode is an empty store, which should
# show red.
SuccessExitStatus=0

# The FRED pull walks 59 series and the narrative is one call. Generous because a
# first run after a long gap re-reads more history.
TimeoutStartSec=20min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
# reports/ and snapshots/ both live inside the checkout (32.3), so the checkout is
# writable. ~/state is permitted-if-present for the status and heartbeat files.
# -%h/chester-data: the live CSV store (ALTDATA_STORE in .env) lives outside the
# checkout so a pass never dirties the tracked data_store/. The leading - lets
# the unit start on a box not yet migrated. deploy/systemd/README.md section 11.
ReadWritePaths=%h/logs -%h/state %h/chester-reports -%h/chester-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# MEMORY CAPS (AUD-2 item 3, session-set for the 8 GB box): MemoryHigh throttles and
# reclaims, MemoryMax is the hard ceiling the kernel kills at. README.md section 13.
MemoryHigh=2G
MemoryMax=2.5G
# THE OOM ORDER (AUD-2, ruled 14 Oct 2026; README.md section 13). If the caps are
# not enough, the kernel kills the highest score first: a report can be rendered
# again; a day's chains cannot be fetched again; the Gateway needs Ari's supervised
# login. So the reports 500, the EOD capture 300, the Gateway -500. Raising a score
# needs no privilege, so this order holds on a --user unit without root.
OOMScoreAdjust=500
