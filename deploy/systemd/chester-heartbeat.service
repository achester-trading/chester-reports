[Unit]
Description=Check the EOD heartbeat and deliver the verdict
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

# No After= or BindsTo= on anything. A monitor that only runs when the thing it
# monitors is up cannot report that the thing is down.

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/check_heartbeat_cron.sh

# THE SECRETS THE RUN NEEDS, AND WHY THIS LINE HAS TO EXIST.
#
# No unit loaded .env and no wrapper sourced it, so anything read through
# os.environ WITHOUT a .env fallback saw nothing on the box. That is not a
# hypothetical: state/emit.py reads CHESTER_STATE_URL and CHESTER_STATE_TOKEN
# from the environment only, so every state record this unit produces would
# have logged "not set -- state emission skipped" and the dashboard would have
# stayed blind to the job that runs every day. altdata/sources/fred.py reads
# FRED_API_KEY the same way.
#
# The leading `-` makes the file OPTIONAL: a box without .env starts the unit
# and the code degrades the way it already knows how, rather than systemd
# refusing to run anything. A missing secret should cost a feature, not the run.
EnvironmentFile=-%h/chester-reports/.env


# SuccessExitStatus is DELIBERATELY ABSENT, which means only 0 counts as
# success and a stale or missing heartbeat leaves this unit in systemd's failed
# state until the next healthy check clears it.
#
# That is the opposite of chester-ibkr-sync.service, which lists 3 4 5 6 as
# success, and the difference is worth stating: there, a sync that reports a
# down Gateway is a sync that WORKED, so failing the unit would confuse "the
# job broke" with "the job found something". Here the job's entire product is
# the alarm. `systemctl --user list-units --failed` becomes a fourth delivery
# channel for free, and a red light is the correct reading of a dead pipeline.
#
# A failed oneshot does not stop its timer: the next 08:30 fires regardless and
# a healthy check clears the state. So there is no restart storm to guard and
# no StartLimit to set.

TimeoutStartSec=2min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
# The checker reads the repo (for the holiday table) and the state dir; the
# wrapper writes the log, the state files and the alert. ProtectSystem=strict
# makes everything else read-only, so these three are named explicitly --
# omitting them is how chester-eod.service would have failed on its first write.
ReadWritePaths=%h/logs %h/.chester
ReadOnlyPaths=%h/chester-reports
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
