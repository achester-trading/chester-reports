[Unit]
Description=IB Gateway health watchdog (the real health authority)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md
# THE WATCHDOG MUST OUTLIVE THE UNIT IT RESTARTS. BindsTo= was here and was
# exactly backwards: it stops this unit whenever ibgateway.service stops, so
# the one moment the watchdog exists for -- a Gateway that has died or wedged
# -- is the moment systemd would have taken the watchdog down with it. A
# watchdog that cannot run while its subject is down is not a watchdog.
#
# OBSERVED, 6 Sep 2026, and worse than the theory. `systemctl restart` STOPS
# the unit before starting it, and BindsTo= propagated that stop straight back
# here: systemd SIGTERMed the watchdog in the middle of its own restart call,
# every time, so the restart counter never reached disk. The log read
# "restart 1 of 3 today" over and over while the state file stayed frozen at
# RESTARTS=0 -- four restarts in two seconds, 84 launch attempts in a day,
# against a Gateway that needs ~90s to authenticate and was being killed after
# one. The daily cap could not fire because the thing that increments it was
# being killed by the thing it was counting.
#
# After= AND NOTHING ELSE. Ordering is the entire dependency this unit needs.
#
# NO Wants=, and that absence is the point. Wants= is a START dependency, so
# systemd would attempt to start ibgateway.service every time this unit fires
# -- every five minutes -- and a deliberately stopped Gateway would be back up
# before the script's is-active guard ever ran. A DELIBERATE STOP MUST STICK:
# the order-placement procedure depends on being able to take the Gateway down
# and have it stay down, and a monitor that quietly undoes an operator's
# `systemctl stop` is worse than no monitor, because the operator believes the
# thing is off.
#
# So the "do not restart what a human deliberately stopped" rule lives where it
# can actually read the intent: ibgateway_watchdog.sh checks
# `systemctl is-active` before probing and reports unit_inactive without
# restarting. That is the mechanism. A dependency edge cannot express intent,
# which is why BindsTo= was wrong in one direction and Wants= in the other.
After=ibgateway.service

[Service]
Type=oneshot

# The probe IS the sync's own connection, so "healthy" has exactly one
# definition in this system. See scripts/ibgateway_watchdog.sh.
ExecStart=%h/chester-reports/scripts/ibgateway_watchdog.sh

# The watchdog restarts ibgateway.service, so it needs to be able to talk to
# the user manager. Nothing here needs privilege beyond that.
NoNewPrivileges=true
PrivateTmp=true

# A probe that hangs is itself a symptom, but it must not pin the timer.
TimeoutStartSec=3min

# Exit 2 means "unhealthy and restart suppressed -- a human is required".
# Neither 1 nor 2 is a systemd failure worth restarting: the watchdog did its
# job and reported. Treat them as success at the unit level so the timer keeps
# firing, and read the log or the status file for the verdict.
SuccessExitStatus=0 1 2

# --- ENABLE IS DELIBERATELY HELD BACK ------------------------------------
# Nothing in this deployment auto-starts. See ibgateway.service and README.md
# section 4. Enable the TIMER, not this unit.
