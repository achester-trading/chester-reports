[Unit]
Description=Levered-ETF close-flow estimate, 15:00 ET on trading days (item 116)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

[Timer]
# 15:00 ET: the levered-ETF rebalance trades in the last 30 minutes, so the
# estimate and its flag (O-1, $20bn either way) land before 15:30 (signal-triage
# Batch 22 item 116, A127). Clear of the 15:49 auction sampler and the 16:10 EOD
# pass; chester-ibkr-sync's 15:00 tick reads the account, not the store's prices.
OnCalendar=Mon-Fri 15:00 America/New_York

# A minute of jitter at most: the read is of the last completed 5-minute bar at
# or before 15:00, so a later start reads the same bar.
RandomizedDelaySec=60

# NO CATCH-UP. A 15:00 estimate computed at 19:00 is not a 15:00 estimate; the
# 16:45 close computes its own from the closes.
Persistent=false

[Install]
WantedBy=timers.target
