[Unit]
Description=Voices scan (06:15 ET) -- desks', strategists' and officials' published views
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/run_voices_scan.sh

# The scan reads the EDGAR contact (its User-Agent) and the model key from .env.
# Optional, as for every unit: without it the scan reports not_configured and
# the reports print each source as not read.
EnvironmentFile=-%h/chester-reports/.env

SuccessExitStatus=0

# Its own limit (PB-1, 5 Oct 2026): the scan's budget is fifteen minutes
# (config/voices_sources.yaml time_budget_seconds), plus margin for the seed and
# the 13F lookup. It no longer shares the overnight pass's ten minutes.
TimeoutStartSec=20min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=%h/logs %h/.chester %h/chester-reports -%h/state -%h/chester-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# MEMORY CAPS (AUD-2 item 3, session-set for the 8 GB box): MemoryHigh throttles and
# reclaims, MemoryMax is the hard ceiling the kernel kills at. README.md section 13.
# THE CAPS FOLLOW THE MACHINE (ruled 17 Oct 2026: the box stays at 4 GB):
# percentages of physical memory. The 8 GB case they equal is AUD-2's
# MemoryHigh=0.8G MemoryMax=1G; on the 4 GB box they read half that.
MemoryHigh=10%
MemoryMax=12%
# THE OOM ORDER (AUD-2, ruled 14 Oct 2026; README.md section 13). If the caps are
# not enough, the kernel kills the highest score first: a report can be rendered
# again; a day's chains cannot be fetched again; the Gateway needs Ari's supervised
# login. So the reports 500, the EOD capture 300, the Gateway -500. Raising a score
# needs no privilege, so this order holds on a --user unit without root.
OOMScoreAdjust=500
