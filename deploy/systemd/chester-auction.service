[Unit]
Description=Closing-auction tick sampler (29.4 logging only -- absorption is 6h)
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

# THE SAMPLER NEVER STARTS THE GATEWAY (AUD-2 item 2, 14 Oct 2026). This said
# Wants=ibgateway.service, and a Wants STARTS the wanted unit: every weekday at
# 15:49 a stopped Gateway was started, and its ExecStartPre cleared the operator's
# ~/state/gateway.stopped_by_operator -- so a Gateway stopped on purpose (an order
# placed by hand in the GUI) came back with its watchdog re-armed, from a logger.
# Now there is no Wants and no Requires. After= only orders the two when both are
# starting anyway; it starts nothing. The sampler itself checks the marker and the
# port, and with either it logs "Gateway stopped by operator" (or that the Gateway
# is not up) and exits 0 without connecting.
After=ibgateway.service

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/run_auction_sampler.sh

EnvironmentFile=-%h/chester-reports/.env

# THE WHOLE RUN IS ELEVEN MINUTES AT MOST, and it must not outlive its own window:
# a sampler still holding market-data lines at 16:15 is competing with the 16:10 EOD
# pass for the account's line cap. 780 seconds is 15:49 to 16:02 with slack for the
# connection.
TimeoutStartSec=780

# READ-ONLY, ASSERTED AT TWO LEVELS. The connection is opened with readonly=True by
# altdata/sources/ibkr_portfolio.connect(), and this unit adds nothing that could
# place an order. There is no order path in this repo and the permission rules deny
# every entry point one would use.
SuccessExitStatus=0

# THE SAME SANDBOX AS chester-eod.service (AUD-2 item 2), with the narrowest write
# set this run needs: its log, its status and lock in the state directory, and the
# checkout (the wrapper's git pull, and data/chester.db where the ticks land). The
# state directory is ~/state on this box (its declared drop-in; box-config.allow),
# where it also reads the Gateway's stop marker, so -%h/state is writable
# (ruling 7, 19 Oct 2026); ~/.chester is the default elsewhere.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=%h/logs %h/.chester -%h/state %h/chester-reports
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
