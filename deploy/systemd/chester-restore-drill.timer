[Unit]
Description=Restore drill, monthly (the 3rd at 10:30 ET) -- PRINTED, NEVER ENABLED BY A DEPLOY
Documentation=file:///%h/chester-reports/docs/runbooks/restore.md

[Timer]
# The 3rd of each month at 10:30 ET: clear of the 1st's 07:30 Monthly, inside the
# weekday operating window, and hours after the 02:30 sweep wrote the snapshot it
# restores. A weekend 3rd simply runs on the weekend, which is also open.
OnCalendar=*-*-03 10:30 America/New_York
RandomizedDelaySec=5min
Persistent=true

# NOT IN DEPLOY_TIMERS (scripts/deploy_remote.sh). The self-deploy copies this file
# to the box and enables nothing; the operator enables it once, by hand, after a
# first supervised run: docs/briefs/aud-2-notes.md, "Box commands".

[Install]
WantedBy=timers.target
