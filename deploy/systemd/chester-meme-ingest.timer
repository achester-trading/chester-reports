[Unit]
Description=chester-meme packet ingest at 21:15 ET (Mon-Fri and Sun, after the 19:30 evening scan) -- PRINTED, NEVER ENABLED BY A DEPLOY
Documentation=file:///%h/chester-reports/docs/interface/README-interface.md

[Timer]
# 21:15 ET on the evenings chester-meme scans (Mon-Fri and Sun, 19:30): after the
# scan's packets are written (by about 19:45; the contract reads after 20:15), in
# the evening window, clear of the 16:00-17:20 passes. Moved from 21:45 by the
# secondary-notes order (19 Oct 2026, section 5) so the 21:30 evening note shows
# tonight's Book D drafts; with the two-minute random delay it is done before
# 21:30. It shares no lock and no input with the note.
OnCalendar=Mon..Fri,Sun *-*-* 21:15 America/New_York
RandomizedDelaySec=120
Persistent=true

# NOT IN DEPLOY_TIMERS (scripts/deploy_remote.sh): the operator enables it after
# reading one ingest by hand (docs/briefs/meme-ingest-ledgers-1-notes.md).

[Install]
WantedBy=timers.target
