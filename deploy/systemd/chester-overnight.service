[Unit]
Description=Overnight market fetch (06:45 ET) -- the only fetch in the morning chain
Documentation=file:///%h/chester-reports/deploy/systemd/README.md

[Service]
Type=oneshot
ExecStart=%h/chester-reports/scripts/fetch_overnight.sh

# Optional, per the same reasoning as every other unit: a box without .env
# starts and the code degrades the way it already knows how. A missing secret
# should cost a feature, not the run. This unit needs none of the mail
# credentials -- it writes to the store and sends nothing -- but it does read
# CHESTER_STATE_URL/TOKEN if a state row is ever added here.
EnvironmentFile=-%h/chester-reports/.env

# 1 is NOT success. "Nothing fetched" means every symbol failed or yfinance is
# absent, and unlike a report with an empty block that is a real failure of this
# unit's one job. It should show red.
SuccessExitStatus=0

# Sized to the whole pass, not the fetch. The fetch is ten HTTP calls with 0.4s
# pacing, but the unit also runs the correction pull, the weekly and annual
# checks, the events ingest and the surprises -- and on 28, 29 and 30 Sep 2026 a
# full correction pull (79 FRED series, 22 writers) ran first, overran the old
# 5min, and systemd killed the pass before the fetch started. The fetch now runs
# first and the pull is the early set only (scripts/fetch_overnight.sh), so this
# is margin, not the fix: a pass at 06:45 that needs 10min still ends before the
# 07:00 anchor reads the rows only if the fetch went first, which it now does.
TimeoutStartSec=10min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
# The store is inside the checkout, so the checkout is writable here.
# ~/state is listed with a leading '-' so it is permitted-if-present rather
# than required. This box redirects CHESTER_STATE_DIR there via a box-local
# drop-in (see box-config.allow); ProtectSystem=strict would otherwise refuse
# every write to it silently. Declaring it here rather than in the drop-in
# keeps the box-local surface down to the Environment= lines alone -- the
# smaller that surface, the less there is for a drift check to have to forgive.
# The '-' means a box that does not use ~/state is unaffected: without it,
# systemd fails the unit outright when the path does not exist.
# -%h/chester-data: the live CSV store (ALTDATA_STORE in .env) lives outside the
# checkout so a pass never dirties the tracked data_store/. The leading - lets
# the unit start on a box not yet migrated. deploy/systemd/README.md section 11.
ReadWritePaths=%h/logs %h/.chester %h/chester-reports -%h/state -%h/chester-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
